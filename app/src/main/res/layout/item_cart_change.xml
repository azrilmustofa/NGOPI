<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu satu item di sheet_cart_changes: "HARGA DIPERBARUI" (sebelumnya -> sekarang) atau "STOK HABIS". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_outline"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvChangeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:textColor="@color/ngopi_primary"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChangeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ngopi_ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Harga berubah -->
    <LinearLayout
        android:id="@+id/llChangePrices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cart_changes_previous"
                android:textColor="@color/ngopi_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvChangeOldPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ngopi_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cart_changes_current"
                android:textColor="@color/ngopi_ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChangeNewPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ngopi_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stok habis / pilihan tidak tersedia -->
    <TextView
        android:id="@+id/tvChangeReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ngopi_muted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>

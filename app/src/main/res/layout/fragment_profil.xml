<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_profile_screen_gradient" android:orientation="vertical" tools:context=".ProfilFragment">
    <androidx.core.widget.NestedScrollView android:id="@+id/scrollProfile" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
    <!--  Content Container  -->
    <LinearLayout android:id="@+id/layoutProfileContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="12dp" android:paddingEnd="20dp" android:paddingBottom="16dp">
        <!--  1. Photo Row  -->
        <LinearLayout android:id="@+id/layoutPhotoRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false" android:gravity="center_vertical" android:orientation="horizontal">
            <!--  Avatar Wrapper  -->
            <FrameLayout android:id="@+id/layoutAvatarWrapper" android:layout_width="84dp" android:layout_height="84dp" android:clipChildren="false" android:clipToPadding="false">
                <!--  Lingkaran Avatar Gradient  -->
                <FrameLayout android:id="@+id/layoutAvatarCircle" android:layout_width="84dp" android:layout_height="84dp" android:background="@drawable/bg_avatar_circle" android:elevation="8dp">
                    <TextView android:id="@+id/tvAvatarInitials" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:fontFamily="sans-serif" android:includeFontPadding="false" android:text="NP" android:textColor="#FFFBF7" android:textSize="30sp" android:textStyle="bold"/>
                </FrameLayout>
                <!--  Camera / Edit Badge  -->
                <FrameLayout android:id="@+id/btnAvatarBadge" android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="top|start" android:layout_marginStart="54dp" android:layout_marginTop="54dp" android:background="@drawable/bg_camera_badge" android:elevation="9dp">
                    <ImageView android:id="@+id/ivAvatarBadgeIcon" android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_lucide_pencil" app:tint="#A85311"/>
                </FrameLayout>
            </FrameLayout>
            <!--  Photo Info  -->
            <LinearLayout android:id="@+id/layoutPhotoInfo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvPhotoTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Foto profil" android:textColor="#522500" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvPhotoSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif" android:text="JPG atau PNG, maksimal 2 MB" android:textColor="#85654F" android:textSize="12sp"/>
                <TextView android:id="@+id/btnChangePhoto" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:clickable="true" android:focusable="true" android:fontFamily="sans-serif" android:text="Ganti foto" android:textColor="#A85311" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
        <!--  2. Form Section  -->
        <LinearLayout android:id="@+id/layoutFormSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:clipChildren="false" android:clipToPadding="false" android:orientation="vertical">
            <!--  Field 1: Nama Lengkap  -->
            <LinearLayout android:id="@+id/layoutFieldName" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/layoutLabelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/tvLabelName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="Nama lengkap" android:textColor="#522500" android:textSize="12sp"/>
                    <TextView android:id="@+id/btnEditName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:fontFamily="sans-serif" android:text="Edit" android:textColor="#A85311" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutInputName" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input_active" android:elevation="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                    <ImageView android:id="@+id/ivIconName" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_lucide_user" app:tint="#A85311"/>
                    <!--  ID disesuaikan dengan ProfilFragment.kt: tvProfileName  -->
                    <EditText android:id="@+id/tvProfileName" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@null" android:fontFamily="sans-serif" android:gravity="center_vertical" android:inputType="textPersonName" android:text="Nadia Putri" android:textColor="#522500" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
            <!--  Field 2: Nomor WhatsApp  -->
            <LinearLayout android:id="@+id/layoutFieldPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:orientation="vertical">
                <LinearLayout android:id="@+id/layoutLabelPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/tvLabelPhone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="Nomor WhatsApp" android:textColor="#522500" android:textSize="12sp"/>
                    <TextView android:id="@+id/btnEditPhone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:fontFamily="sans-serif" android:text="Edit" android:textColor="#A85311" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutInputPhone" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input_default" android:elevation="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                    <TextView android:id="@+id/tvPhonePrefix" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="+62" android:textColor="#522500" android:textSize="14sp" android:textStyle="bold"/>
                    <View android:id="@+id/dividerPhonePrefix" android:layout_width="1dp" android:layout_height="20dp" android:layout_marginStart="10dp" android:background="#FFDCC2"/>
                    <!--  ID disesuaikan dengan ProfilFragment.kt: tvProfilePhone  -->
                    <EditText android:id="@+id/tvProfilePhone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@null" android:fontFamily="sans-serif" android:gravity="center_vertical" android:inputType="phone" android:text="812 3456 7890" android:textColor="#522500" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
            <!--  Field 3: Email  -->
            <LinearLayout android:id="@+id/layoutFieldEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:orientation="vertical">
                <LinearLayout android:id="@+id/layoutLabelEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/tvLabelEmail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="Email" android:textColor="#522500" android:textSize="12sp"/>
                    <TextView android:id="@+id/btnEditEmail" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:fontFamily="sans-serif" android:text="Edit" android:textColor="#A85311" android:textSize="13sp" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutInputEmail" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="7dp" android:background="@drawable/bg_input_default" android:elevation="4dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                    <ImageView android:id="@+id/ivIconEmail" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_lucide_mail" app:tint="#85654F"/>
                    <!--  ID disesuaikan dengan ProfilFragment.kt: tvProfileEmail  -->
                    <EditText android:id="@+id/tvProfileEmail" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@null" android:fontFamily="sans-serif" android:gravity="center_vertical" android:inputType="textEmailAddress" android:text="nadia@email.com" android:textColor="#522500" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <!--  3. Change Password Row (ID disesuaikan: rowEditPassword)  -->
        <LinearLayout android:id="@+id/rowEditPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_change_password_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
            <ImageView android:id="@+id/ivIconPassword" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_lucide_lock" app:tint="#A85311"/>
            <TextView android:id="@+id/tvEditPassword" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="Ubah kata sandi" android:textColor="#522500" android:textSize="14sp"/>
            <ImageView android:id="@+id/ivChevronPassword" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_lucide_chevron_right" app:tint="#85654F"/>
        </LinearLayout>
        <!--  Baris Pusat Bantuan & Syarat Ketentuan (disediakan agar ProfilFragment.kt tidak Force Close/Error)  -->
        <LinearLayout android:id="@+id/rowHelpCenter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_change_password_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_help" app:tint="#A85311"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/profile_help_cashier" android:textColor="#522500" android:textSize="14sp"/><ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_lucide_chevron_right" app:tint="#85654F"/></LinearLayout>
        <LinearLayout android:id="@+id/rowTerms" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_change_password_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp"><ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_receipt" app:tint="#A85311"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:text="@string/profile_terms" android:textColor="#522500" android:textSize="14sp"/><ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_lucide_chevron_right" app:tint="#85654F"/></LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="8dp" android:paddingEnd="20dp" android:paddingBottom="16dp">
        <LinearLayout android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" android:background="@drawable/bg_logout_button" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="horizontal">
            <ImageView android:id="@+id/ivIconLogout" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_lucide_log_out" app:tint="#A4483D"/>
            <TextView android:id="@+id/tvLogout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:fontFamily="sans-serif" android:text="Keluar" android:textColor="#A4483D" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
        <!--  Saat edit: Keluar disembunyikan, diganti Batal + Simpan  -->
        <LinearLayout android:id="@+id/llEditActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCancelEdit" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:background="@drawable/bg_card_outline" android:text="@string/profile_cancel" android:textAllCaps="false" android:textColor="@color/ngopi_ink" android:textSize="15sp" android:textStyle="bold"/>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSaveProfile" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginStart="8dp" android:layout_weight="2" android:background="@drawable/bg_button_primary" android:text="@string/profile_save" android:textAllCaps="false" android:textColor="#FFFBF7" android:textSize="15sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
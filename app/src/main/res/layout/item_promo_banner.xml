<?xml version="1.0" encoding="utf-8"?>
<!-- Satu kartu di carousel Menu: promo hari ini, atau menu terlaris kalau tidak ada promo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="154dp"
    android:background="@drawable/bg_card_green"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvBannerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.09"
            android:maxLines="1"
            android:textColor="@color/ngopi_border"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="PROMO HARI INI" />

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ngopi_surface"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="Kopi Susu Gula Aren" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBannerPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ngopi_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Rp19.200" />

            <TextView
                android:id="@+id/tvBannerNormalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/ngopi_border"
                android:textSize="11sp"
                tools:text="Rp24.000" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBannerNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/ngopi_border"
            android:textSize="11sp"
            tools:text="Hemat 20% · s.d. 22.00" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="116dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp">

        <ImageView
            android:id="@+id/ivBannerPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_photo_placeholder"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvBannerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/ngopi_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="-20%" />
    </FrameLayout>
</LinearLayout>

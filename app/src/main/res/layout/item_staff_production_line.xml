<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Heading: Qty & Name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStaffItemQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ngopi_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="1×" />

        <TextView
            android:id="@+id/tvStaffItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/ngopi_ink"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Es Kopi Susu" />
    </LinearLayout>

    <!-- Options Breakdown -->
    <TextView
        android:id="@+id/tvStaffItemOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="3dp"
        android:textColor="@color/ngopi_muted"
        android:textSize="12sp"
        tools:text="Susu segar · Es normal" />

    <!-- Barista Note -->
    <TextView
        android:id="@+id/tvStaffItemNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/ngopi_ink"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Catatan: Sedikit es" />

    <View
        android:id="@+id/vStaffItemDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/ngopi_border" />

</LinearLayout>
